# Get these from https://developer.whoop.com/
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Set this to your Railway public URL + /callback
# e.g. https://whoop-mcp-production.up.railway.app/callback
WHOOP_REDIRECT_URI=https://YOUR_RAILWAY_URL/callback

# Server config (defaults shown)
MCP_MODE=http
PORT=3000
DB_PATH=/data/whoop.db
